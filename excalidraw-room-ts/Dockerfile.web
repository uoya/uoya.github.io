# Stage 1: Build Excalidraw app from source
# VITE_APP_WS_SERVER_URL is intentionally left empty so that socket.io-client
# connects to the current page host; nginx then proxies /socket.io/ to the
# room server internally.
FROM node:22-alpine AS builder
RUN apk add --no-cache git
WORKDIR /app
RUN git clone --depth=1 https://github.com/excalidraw/excalidraw.git .
ENV VITE_APP_WS_SERVER_URL=""
RUN npm ci
RUN npm run build:app

# Stage 2: nginx serves static files and proxies WebSocket to room server
FROM nginx:alpine
COPY --from=builder /app/excalidraw-app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
